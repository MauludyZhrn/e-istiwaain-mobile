{
  "expo": {
    "name": "e-Istiwaain",
    "slug": "e-istiwaain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mldyzhrn.eistiwaain"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f258df95-d81f-4ffa-82b7-8d8382643d88"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#09473E",
          "sounds": [
            "./assets/audio/adzan_subuh.mp3",
            "./assets/audio/adzan_biasa.mp3"
          ]
        }
      ],
      "./plugins/withTransparentAndroidSplashIcon.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09473E",
          "dark": {
            "backgroundColor": "#09473E"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true,
      "url": "https://u.expo.dev/f258df95-d81f-4ffa-82b7-8d8382643d88"
    }
  }
}
